CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 59, Column: 5, IsInlineFrame: false }
CHECK-NEXT:       - Frames:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 64, Column: 5, IsInlineFrame: false }
CHECK-NEXT:   - GUID:            0x7f8d88fcc70a347b
