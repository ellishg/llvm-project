We expect 5 MIBs from the basic-histogram profile.

RUN: rm -rf %t && split-file %s %t
RUN: llvm-profdata merge %t/basic-histogram.yaml -o %t.profdata
RUN: llvm-profdata show --memory %t.profdata | FileCheck %s

CHECK: HeapProfileRecords:
CHECK-NEXT:   - GUID:            0xdb956436e78dd5fa
CHECK-NEXT:     AllocSites:
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 2, Column: 10, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       64
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 12000
