CHECK-NEXT:           - { Function: 0x7f8d88fcc70a347b, LineOffset: 2, Column: 10, IsInlineFrame: false }
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 59, Column: 5, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      21
CHECK-NEXT:           TotalSize:       1344
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 252000
