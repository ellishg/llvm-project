This test verifies that profiles originally from v4 memprofraw produce
the expected YAML output after round-tripping through indexed format.

RUN: rm -rf %t && split-file %s %t
RUN: llvm-profdata merge %t/basic_v4.yaml -o %t.profdata
RUN: llvm-profdata show --memory %t.profdata | FileCheck %s

CHECK: HeapProfileRecords:
CHECK-NEXT:   - GUID:            0xdb956436e78dd5fa
CHECK-NEXT:     AllocSites:
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 1, Column: 21, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       10
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 20000
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 4, Column: 15, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       10
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 20000
CHECK-NEXT: ...

;--- basic_v4.c
#include <stdlib.h>
#include <string.h>
int main(int argc, char **argv) {
  char *x = (char *)malloc(10);
  memset(x, 0, 10);
  free(x);
  x = (char *)malloc(10);
  memset(x, 0, 10);
  free(x);
  return 0;
}
;--- gen
DEFAULT_MEMPROF_FLAGS="-fuse-ld=lld -Wl,--no-rosegment -gmlt -fdebug-info-for-profiling -fmemory-profile -mno-omit-leaf-frame-pointer -fno-omit-frame-pointer -fno-optimize-sibling-calls -m64 -Wl,-build-id -no-pie"
clang $DEFAULT_MEMPROF_FLAGS basic_v4.c -o basic_v4.memprofexe
env MEMPROF_OPTIONS=log_path=stdout ./basic_v4.memprofexe > basic_v4.memprofraw
llvm-profdata merge basic_v4.memprofraw --profiled-binary basic_v4.memprofexe -o basic_v4.profdata
llvm-profdata show --memory basic_v4.profdata
;--- basic_v4.yaml
---
# MemProfSummary:
#   Total contexts: 2
#   Total cold contexts: 0
#   Total hot contexts: 0
#   Maximum cold context total size: 0
#   Maximum warm context total size: 10
#   Maximum hot context total size: 0
---
HeapProfileRecords:
  - GUID:            0xdb956436e78dd5fa
    AllocSites:
      - Callstack:
          - { Function: 0xdb956436e78dd5fa, LineOffset: 1, Column: 21, IsInlineFrame: false }
        MemInfoBlock:
          AllocCount:      1
          TotalSize:       10
          TotalLifetime:   0
          TotalLifetimeAccessDensity: 20000
      - Callstack:
          - { Function: 0xdb956436e78dd5fa, LineOffset: 4, Column: 15, IsInlineFrame: false }
        MemInfoBlock:
          AllocCount:      1
          TotalSize:       10
          TotalLifetime:   0
          TotalLifetimeAccessDensity: 20000
...
