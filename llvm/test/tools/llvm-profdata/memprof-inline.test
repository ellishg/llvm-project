RUN: rm -rf %t && split-file %s %t
RUN: llvm-profdata merge %t/inline.yaml -o %t.profdata
RUN: llvm-profdata show --memory %t.profdata | FileCheck %s

CHECK: HeapProfileRecords:
CHECK-NEXT:   - GUID:            0xdb956436e78dd5fa
CHECK-NEXT:     CallSites:
CHECK-NEXT:       - Frames:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 1, Column: 3, IsInlineFrame: false }
CHECK-NEXT:   - GUID:            0x110c56e259526faa
CHECK-NEXT:     AllocSites:
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0x35c1d64fabd64b9c, LineOffset: 1, Column: 23, IsInlineFrame: true }
CHECK-NEXT:           - { Function: 0x110c56e259526faa, LineOffset: 0, Column: 18, IsInlineFrame: false }
CHECK-NEXT:           - { Function: 0x33bc29154aca5065, LineOffset: 0, Column: 19, IsInlineFrame: false }
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 1, Column: 3, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       1
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 100000
CHECK-NEXT:     CallSites:
CHECK-NEXT:       - Frames:
CHECK-NEXT:           - { Function: 0x35c1d64fabd64b9c, LineOffset: 1, Column: 23, IsInlineFrame: true }
CHECK-NEXT:           - { Function: 0x110c56e259526faa, LineOffset: 0, Column: 18, IsInlineFrame: false }
CHECK-NEXT:   - GUID:            0x35c1d64fabd64b9c
CHECK-NEXT:     AllocSites:
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0x35c1d64fabd64b9c, LineOffset: 1, Column: 23, IsInlineFrame: true }
CHECK-NEXT:           - { Function: 0x110c56e259526faa, LineOffset: 0, Column: 18, IsInlineFrame: false }
CHECK-NEXT:           - { Function: 0x33bc29154aca5065, LineOffset: 0, Column: 19, IsInlineFrame: false }
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 1, Column: 3, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       1
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 100000
CHECK-NEXT:   - GUID:            0x33bc29154aca5065
CHECK-NEXT:     CallSites:
CHECK-NEXT:       - Frames:
CHECK-NEXT:           - { Function: 0x33bc29154aca5065, LineOffset: 0, Column: 19, IsInlineFrame: false }
CHECK-NEXT: ...

;--- inline.cpp
#include <stdlib.h>
#include <string.h>

__attribute__((always_inline))
void qux(int x) {
  char *ptr = (char*) malloc(x);
  memset(ptr, 0, x);
  free(ptr);
}

__attribute__((noinline))
void foo(int x){ qux(x); }

__attribute__((noinline))
void bar(int x) { foo(x); }

int main(int argc, char **argv) {
  bar(argc);
  return 0;
}
;--- gen
DEFAULT_MEMPROF_FLAGS="-fuse-ld=lld -Wl,--no-rosegment -gmlt -fdebug-info-for-profiling -fmemory-profile -mno-omit-leaf-frame-pointer -fno-omit-frame-pointer -fno-optimize-sibling-calls -m64 -Wl,-build-id -no-pie"
clang++ $DEFAULT_MEMPROF_FLAGS inline.cpp -o inline.memprofexe
env MEMPROF_OPTIONS=log_path=stdout ./inline.memprofexe > inline.memprofraw
llvm-profdata merge inline.memprofraw --profiled-binary inline.memprofexe -o inline.profdata
llvm-profdata show --memory inline.profdata
;--- inline.yaml
---
