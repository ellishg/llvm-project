RUN: rm -rf %t && split-file %s %t

RUN: llvm-profdata merge %t/proftext %t/basic.yaml --memprof-version=2 -o %t.prof.v2
RUN: llvm-profdata show %t.prof.v2 | FileCheck %s

RUN: llvm-profdata merge %t/proftext %t/basic.yaml --memprof-version=2 --memprof-full-schema -o %t.prof.v2
RUN: llvm-profdata show %t.prof.v2 | FileCheck %s

RUN: llvm-profdata merge %t/proftext %t/basic.yaml --memprof-version=3 -o %t.prof.v3
RUN: llvm-profdata show %t.prof.v3 | FileCheck %s

RUN: llvm-profdata merge %t/proftext %t/basic.yaml --memprof-version=3 --memprof-full-schema -o %t.prof.v3
RUN: llvm-profdata show %t.prof.v3 | FileCheck %s

Check to see if llvm-profdata produces V3 by default.
RUN: llvm-profdata merge %t/proftext %t/basic.yaml --memprof-full-schema -o %t.prof.default
RUN: cmp %t.prof.default %t.prof.v3

For now we only check the validity of the instrumented profile since we don't
have a way to display the contents of the memprof indexed format yet.

CHECK: Instrumentation level: IR  entry_first = 0
CHECK: Total functions: 1
CHECK: Maximum function count: 1
CHECK: Maximum internal block count: 0

;--- basic.c
#include <stdlib.h>
#include <string.h>
int main(int argc, char **argv) {
  char *x = (char *)malloc(10);
  memset(x, 0, 10);
  free(x);
  x = (char *)malloc(10);
  memset(x, 0, 10);
  free(x);
  return 0;
}
;--- proftext
:ir
main
742261418966908927
1
1

;--- gen
DEFAULT_MEMPROF_FLAGS="-fuse-ld=lld -Wl,--no-rosegment -gmlt -fdebug-info-for-profiling -fmemory-profile -mno-omit-leaf-frame-pointer -fno-omit-frame-pointer -fno-optimize-sibling-calls -m64 -Wl,-build-id -no-pie"
clang $DEFAULT_MEMPROF_FLAGS basic.c -o basic.memprofexe
env MEMPROF_OPTIONS=log_path=stdout ./basic.memprofexe > basic.memprofraw
llvm-profdata merge basic.memprofraw --profiled-binary basic.memprofexe -o basic.profdata
llvm-profdata show --memory basic.profdata
;--- basic.yaml
---
