We expect 2 different MIBs. This tests the padding-histogram profile.

RUN: rm -rf %t && split-file %s %t
RUN: llvm-profdata merge %t/padding-histogram.yaml -o %t.profdata
RUN: llvm-profdata show --memory %t.profdata | FileCheck %s

CHECK: HeapProfileRecords:
CHECK-NEXT:   - GUID:            0xdb956436e78dd5fa
CHECK-NEXT:     AllocSites:
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 3, Column: 10, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       24
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 20000
CHECK-NEXT:       - Callstack:
CHECK-NEXT:           - { Function: 0xdb956436e78dd5fa, LineOffset: 10, Column: 10, IsInlineFrame: false }
CHECK-NEXT:         MemInfoBlock:
CHECK-NEXT:           AllocCount:      1
CHECK-NEXT:           TotalSize:       48
CHECK-NEXT:           TotalLifetime:   0
CHECK-NEXT:           TotalLifetimeAccessDensity: 8000
CHECK-NEXT: ...

;--- padding-histogram.cpp
struct A {
  char a;
  char b;
  long int c;
  char d;
  int e;
  A() {};
};

struct B {
  double x;
  double y;
  B() {};
};

struct C {
  A a;
  char z;
  B b;
  C() {};
};

int main(int argc, char **argv) {
  long int acc = 0;

  A *a = new A();
  acc += a->a;
  acc += a->b;
  acc += a->c;
  acc += a->d;
  acc += a->e;

  C *c = new C();
  acc += c->a.a;
  acc += c->a.a;
  acc += c->b.x;
  acc += c->b.y;

  return 0;
}
;--- gen
DEFAULT_MEMPROF_FLAGS="-fuse-ld=lld -Wl,--no-rosegment -gmlt -fdebug-info-for-profiling -fmemory-profile -mno-omit-leaf-frame-pointer -fno-omit-frame-pointer -fno-optimize-sibling-calls -m64 -Wl,-build-id -no-pie"
DEFAULT_HIST_FLAGS="$DEFAULT_MEMPROF_FLAGS -mllvm -memprof-use-callbacks=true -mllvm -memprof-histogram"
clang++ $DEFAULT_HIST_FLAGS padding-histogram.cpp -o padding-histogram.memprofexe
env MEMPROF_OPTIONS=log_path=stdout ./padding-histogram.memprofexe > padding-histogram.memprofraw
llvm-profdata merge padding-histogram.memprofraw --profiled-binary padding-histogram.memprofexe -o padding-histogram.profdata
llvm-profdata show --memory padding-histogram.profdata
;--- padding-histogram.yaml
---
# MemProfSummary:
#   Total contexts: 2
#   Total cold contexts: 0
#   Total hot contexts: 0
#   Maximum cold context total size: 0
#   Maximum warm context total size: 48
#   Maximum hot context total size: 0
---
HeapProfileRecords:
  - GUID:            0xdb956436e78dd5fa
    AllocSites:
      - Callstack:
          - { Function: 0xdb956436e78dd5fa, LineOffset: 3, Column: 10, IsInlineFrame: false }
        MemInfoBlock:
          AllocCount:      1
          TotalSize:       24
          TotalLifetime:   0
          TotalLifetimeAccessDensity: 20000
      - Callstack:
          - { Function: 0xdb956436e78dd5fa, LineOffset: 10, Column: 10, IsInlineFrame: false }
        MemInfoBlock:
          AllocCount:      1
          TotalSize:       48
          TotalLifetime:   0
          TotalLifetimeAccessDensity: 8000
...
